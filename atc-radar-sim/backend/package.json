  "main": "dist/index.js",
  "scripts": {
    "sim": "tsx watch simulator_service/index.ts",
    "noti": "tsx watch notification_service/worker.ts",
    "build": "tsc && npm run postbuild",
    "postbuild": "mkdir -p node_modules/@atc-radar-sim && cp -r ../shared node_modules/@atc-radar-sim/",
