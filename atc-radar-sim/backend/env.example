# Backend Environment Variables
# Copy this to .env for local development
# For deployment, set these in your hosting platform (Render, Railway, etc.)

# Environment mode
NODE_ENV=production

# Server port (use PORT for cloud providers like Render, Railway)
PORT=4000

# Frontend URL for CORS (update this with your actual frontend URL)
# Local development:
# CORS_ORIGIN=http://localhost:3000
# Production (Vercel example):
CORS_ORIGIN=https://your-app-name.vercel.app

# Multiple origins (comma-separated, optional):
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-staging.vercel.app

# Database (if using Prisma in future)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

