# Frontend Environment Variables
# Copy this to .env.local for local development
# For deployment, set these in your hosting platform (Vercel, Netlify, etc.)

# Backend WebSocket URL
# Local development:
# NEXT_PUBLIC_WS_URL=http://localhost:4000
# Production (Render example):
NEXT_PUBLIC_WS_URL=https://your-backend-name.onrender.com

# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Don't use NEXT_PUBLIC_ for sensitive data like API keys

